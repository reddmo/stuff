---
eleventyNavigation:
  key: Home
  order: 1
numberOfLatestPostsToShow: 6
---
{% set postsCount = collections.posts | length %}
{% set latestPostsCount = postsCount | min(numberOfLatestPostsToShow) %}
<h1>The Most Recent {{ latestPostsCount }} Post{% if latestPostsCount != 1 %}s{% endif %}</h1>

{% set postslist = collections.posts | head(-1 * numberOfLatestPostsToShow) %}
{% set postslistCounter = postsCount %}
{% include "postslist.njk" %}

{% set morePosts = postsCount - numberOfLatestPostsToShow %}
{% if morePosts > 0 %}
<p>{{ morePosts }} more post{% if morePosts != 1 %}s{% endif %} can be found in <a href="blog.njk"> the blog</a> or check out the <a href="notes.njk"> notes</a> that hit my <a href="{{ metadata.mastodonUrl }}"> social.lol feed</a>.</p>
{% endif %}